# Copy to .env.local and fill in. Find these in the Supabase dashboard under
# Project Settings > API (or run `pnpm supabase status` for a local stack).
# NEXT_PUBLIC_ variables are inlined into the browser bundle, so only public values go here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security. Used by server actions for the
# Auth admin API (invites, bans). Never prefix with NEXT_PUBLIC_, never commit.
# Dashboard: Project Settings > API Keys > Secret key (or legacy service_role).
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Deep link prefix for the "open the DeltaGuard app" button on invite emails.
# Expo Go during development: exp://<your-PC-LAN-IP>:8081/--/
# Development or store build: deltaguard://
MOBILE_APP_LINK_BASE=deltaguard://

# Local development only: skip the TOTP two-factor step when signing in to the
# console. Ignored by production builds (`next build` / `next start`), which
# always require it. Remove the line to turn two-factor back on.
# ADMIN_SKIP_MFA=true
