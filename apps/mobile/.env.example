# Copy to .env and fill in. Find these in the Supabase dashboard under
# Project Settings > API (or run `pnpm supabase status` for a local stack).
# Only EXPO_PUBLIC_ variables reach the app, and they are bundled into it in
# plain text, so never put secrets (like the service_role key) here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
