{
  "expo": {
    "name": "DeltaGuard",
    "slug": "deltaguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "deltaguard",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.deltaconsecurity.deltaguard"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050E1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deltaconsecurity.deltaguard",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050E1D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DeltaGuard uses your location only at the moment you clock in or out of a shift, or send an SOS, to confirm you are at your post. It never tracks you in the background.",
          "locationAlwaysAndWhenInUsePermission": "DeltaGuard uses your location only at the moment you clock in or out of a shift, or send an SOS, to confirm you are at your post. It never tracks you in the background.",
          "locationAlwaysPermission": "DeltaGuard uses your location only at the moment you clock in or out of a shift, or send an SOS, to confirm you are at your post. It never tracks you in the background.",
          "locationFullAccuracyPermission": "DeltaGuard needs your precise location to confirm you are at your post when you clock in or out.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "DeltaGuard uses the camera when you choose to add a photo to an incident report or your daily activity report.",
          "photosPermission": "DeltaGuard opens your photos when you choose to attach them to an incident report or your daily activity report.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#D6B562",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#050E1D",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "50468283-33ec-426c-be79-08b0a5869f1b"
      }
    }
  }
}
