{
  "expo": {
    "name": "DeltaGuard",
    "slug": "deltaguard",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "deltaguard",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.deltaconsecurity.deltaguard",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true,
        "com.apple.developer.devicecheck.appattest-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050E1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deltaconsecurity.deltaguard",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "allowBackup": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050E1D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "DeltaGuard checks where you are only at the moment you clock in, clock out or send an SOS. This confirms you are at your post and tells responders where to find you. It never tracks you in the background.",
          "locationAlwaysAndWhenInUsePermission": "DeltaGuard checks where you are only at the moment you clock in, clock out or send an SOS. This confirms you are at your post and tells responders where to find you. It never tracks you in the background.",
          "locationAlwaysPermission": "DeltaGuard checks where you are only at the moment you clock in, clock out or send an SOS. This confirms you are at your post and tells responders where to find you. It never tracks you in the background.",
          "locationFullAccuracyPermission": "DeltaGuard needs your exact location to confirm you are inside the site area when you clock in or out.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isAndroidMotionActivityEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "DeltaGuard uses Face ID to unlock the app and to confirm it is you when you sign a form."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "DeltaGuard uses the camera only when you take a photo for an incident report, your daily activity report or a message.",
          "photosPermission": "DeltaGuard opens your photos only when you choose one to add to an incident report, your daily activity report or a message.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#D6B562",
          "defaultChannel": "default",
          "sounds": [
            "./assets/sounds/welfare_alarm.wav"
          ]
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#050E1D",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "50468283-33ec-426c-be79-08b0a5869f1b"
      }
    },
    "description": "Shifts, clock-in, reports and SOS for Deltacon Security officers.",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/50468283-33ec-426c-be79-08b0a5869f1b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
